PORT=8787
FORGER_WORKSPACE_ROOT=.forger-workspaces

# Authentication. disabled preserves the local single-user development mode.
# Use oidc for hosted deployments. The bearer/JWT may come directly from the
# browser/client or be injected by a trusted same-origin auth proxy.
FORGER_AUTH_MODE=disabled
FORGER_AUTH_TOKEN_HEADER=authorization
FORGER_OIDC_ISSUER=
FORGER_OIDC_AUDIENCE=
FORGER_OIDC_JWKS_URI=
FORGER_OIDC_ALGORITHMS=RS256,ES256,EdDSA
# Defaults to sub (one isolated tenant per authenticated subject).
# For organization workspaces use the verified organization claim, e.g. org_id.
FORGER_OIDC_TENANT_CLAIM=sub

# Any OpenAI-compatible chat-completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5

# Optional. Required only for publishing a reviewed Blueprint to GitHub.
# Use the narrowest repository-scoped token possible. Read access is enough
# for review; publishing needs Contents: write on the chosen repository.
FORGER_GITHUB_TOKEN=
