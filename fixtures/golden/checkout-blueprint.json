      "data": { "entity": "Order", "canonicalCharacteristic": true }
    },
    {
      "kind": "property",
      "canonicalLabel": "Customer.identityKey",
      "summary": "Canonical characteristic used by Order in this context.",
      "data": { "entity": "Customer", "canonicalCharacteristic": true }
    },
    {
      "kind": "relationship",
      "canonicalLabel": "Order.absorbs.Customer",
      "summary": "Customer completes Order behavior in checkout context.",
      "data": {
        "fromEntity": "Order",
        "toEntity": "Customer",
        "relation": "absorbs_identity",
        "behaviorCompleting": true,
        "canonicalCharacteristic": "Customer.identityKey",
        "context": "Checkout"
      }
    },
    {
      "kind": "identity_rule",
      "canonicalLabel": "Order.CheckoutIdentity",
