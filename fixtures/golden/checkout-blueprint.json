      "data": {
        "entity": "Order",
        "components": [
          { "entity": "Order", "characteristic": "Order.localId" },
          { "entity": "Customer", "characteristic": "Customer.identityKey" }
        ],
        "context": "Checkout",
        "uniqueness": "contextual",
        "behaviorCompleting": true
      }
    }
  ],
  "flow": {
    "kind": "flow",
    "canonicalLabel": "Checkout.Main",
    "summary": "Checkout causal flow.",
    "data": {
      "twoFlow": "-> Checkout.Requested\n[->> OrderAgent.PlaceOrder, ->> PaymentAgent.Authorize]\nerror#last-error\n<- Checkout.Completed"
    }
  },
  "proof": {
    "kind": "proof_obligation",
    "canonicalLabel": "OrderAgent.PlaceOrder.Idempotent",
    "summary": "Repeated request cannot create a second semantic order.",
