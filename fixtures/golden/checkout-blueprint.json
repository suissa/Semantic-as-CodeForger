{
  "action": {
    "kind": "domain_action",
    "canonicalLabel": "OrderAgent.PlaceOrder",
    "summary": "Establish a valid order after checkout is requested.",
    "data": {
      "intent": "PlaceOrder",
      "listenEvent": "Checkout.Requested",
      "input": { "order": "Order" },
      "output": { "order": "Order" },
      "invariants": ["The same checkout request cannot establish two orders."],
      "forbidden": ["Emit success/failure as configurable terminal events."],
      "resultEvents": ["success", "failure"]
    }
  },
  "identityArtifacts": [
    {
      "kind": "entity",
      "canonicalLabel": "Order",
      "summary": "Commercial order.",
      "data": { "identity": "semantic before storage" }
    },
    {
      "kind": "entity",
      "canonicalLabel": "Customer",
      "summary": "Customer identity.",
      "data": {}
    },
    {
      "kind": "property",
